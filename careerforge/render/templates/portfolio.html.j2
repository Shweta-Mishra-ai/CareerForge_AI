<!DOCTYPE html>
<html lang="{{ options.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="color-scheme" content="{{ theme.color_scheme }}">
<meta name="generator" content="CareerForge">
<title>{{ title }}</title>
{% if description %}
<meta name="description" content="{{ description }}">
<meta property="og:description" content="{{ description }}">
<meta name="twitter:description" content="{{ description }}">
{% endif %}
<meta property="og:title" content="{{ title }}">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
{% if options.site_url %}
<link rel="canonical" href="{{ options.site_url }}">
<meta property="og:url" content="{{ options.site_url }}">
{% endif %}
{% set person = {"@context": "https://schema.org", "@type": "Person", "name": p.name} %}
{% if p.headline %}{% set _ = person.update({"jobTitle": p.headline}) %}{% endif %}
{% if description %}{% set _ = person.update({"description": description}) %}{% endif %}
{% if options.site_url %}{% set _ = person.update({"url": options.site_url}) %}{% endif %}
{% if sameas %}{% set _ = person.update({"sameAs": sameas}) %}{% endif %}
<script type="application/ld+json">{{ person | tojson }}</script>
<style>
:root { --bg: {{ theme.bg }}; --surface: {{ theme.surface }}; --text: {{ theme.text }}; --muted: {{ theme.muted }}; --accent: {{ theme.accent }}; --on-accent: {{ theme.accent_text }}; --border: {{ theme.border }}; --font: {{ theme.font }}; }
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--font); line-height: 1.6; font-size: 1.0625rem; }
a { color: var(--accent); text-underline-offset: 0.2em; }
a:focus-visible, .skip:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
.skip { position: absolute; left: 0.5rem; top: -4rem; background: var(--accent); color: var(--on-accent); padding: 0.6rem 1rem; z-index: 10; }
.skip:focus { top: 0.5rem; }
.wrap { width: min(100% - 2rem, 62rem); margin-inline: auto; }
header.hero { padding: 4rem 0 2rem; border-bottom: 1px solid var(--border); }
h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.1; margin: 0; }
.headline { font-size: clamp(1.15rem, 2.6vw, 1.5rem); margin: 0.5rem 0 0; color: var(--muted); }
.stats { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; list-style: none; padding: 0; margin: 1.75rem 0 0; }
.stats strong { display: block; font-size: 1.8rem; line-height: 1.1; }
.stats span { color: var(--muted); font-size: 0.95rem; }
nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; list-style: none; padding: 0; margin: 1.75rem 0 0; }
nav a { display: inline-block; padding: 0.35rem 0; }
main section { padding: 2.75rem 0 0.5rem; }
h2 { font-size: 1.5rem; margin: 0 0 1.1rem; padding-bottom: 0.4rem; border-bottom: 2px solid var(--accent); display: inline-block; }
h3 { font-size: 1.15rem; margin: 0; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 1.1rem; list-style: none; padding: 0; margin: 0; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 0.6rem; padding: 1.1rem 1.2rem; height: 100%; }
.card p { margin: 0.5rem 0 0; }
.meta { color: var(--muted); font-size: 0.95rem; margin: 0.15rem 0 0; }
.chips { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0.7rem 0 0; }
.chips li { background: var(--bg); border: 1px solid var(--border); border-radius: 999px; padding: 0.1rem 0.7rem; font-size: 0.9rem; }
.skillgroup + .skillgroup { margin-top: 1.1rem; }
.skillgroup h3 { font-size: 1rem; color: var(--muted); font-weight: 600; }
.timeline { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--border); }
.timeline > li { position: relative; padding: 0 0 1.5rem 1.4rem; }
.timeline > li::before { content: ""; position: absolute; left: -0.45rem; top: 0.55rem; width: 0.8rem; height: 0.8rem; border-radius: 50%; background: var(--accent); }
.timeline ul, .card ul.points { margin: 0.5rem 0 0; padding-left: 1.2rem; }
.timeline li li, .card .points li { padding: 0; margin: 0.2rem 0; }
.timeline li li::before { display: none; }
.contact { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
.contact a { font-weight: 600; }
footer { margin-top: 3.5rem; padding: 1.5rem 0 3rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.9rem; }
@media print { nav, .skip { display: none; } body { background: #fff; color: #000; } a { color: #000; } .card { break-inside: avoid; } }
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="hero">
<div class="wrap">
<h1>{{ p.name }}</h1>
{% if p.headline %}<p class="headline">{{ p.headline }}</p>{% endif %}
{% if stats %}
<ul class="stats" aria-label="Summary figures">
{% for s in stats %}<li><strong>{{ s.value }}</strong><span>{{ s.label }}</span></li>
{% endfor %}
</ul>
{% endif %}
{% if sections or contact %}
<nav aria-label="Sections">
<ul>
{% for s in sections %}<li><a href="#{{ s }}">{{ titles[s] }}</a></li>
{% endfor %}
{% if contact %}<li><a href="#contact">Contact</a></li>{% endif %}
</ul>
</nav>
{% endif %}
</div>
</header>
<main id="main" class="wrap">
{% for s in sections %}
<section id="{{ s }}" aria-labelledby="h-{{ s }}">
<h2 id="h-{{ s }}">{{ titles[s] }}</h2>
{% if s == "about" %}
<p>{{ p.summary }}</p>
{% elif s == "projects" %}
<ul class="grid">
{% for pr in p.projects %}
<li><article class="card">
<h3>{% if pr.url %}<a href="{{ pr.url }}">{{ pr.name }}</a>{% else %}{{ pr.name }}{% endif %}</h3>
{% if pr.stars %}<p class="meta"><span aria-hidden="true">★</span> {{ pr.stars }} {{ "star" if pr.stars == 1 else "stars" }} on GitHub</p>{% endif %}
{% if pr.description %}<p>{{ pr.description }}</p>{% endif %}
{% if pr.bullets %}<ul class="points">{% for b in pr.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
{% if pr.tech %}<ul class="chips" aria-label="Technologies">{% for t in pr.tech %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
</article></li>
{% endfor %}
</ul>
{% elif s == "experience" %}
<ol class="timeline">
{% for e in blocks["experience"].entries %}
<li>
<h3>{{ e.head }}</h3>
<p class="meta">{{ [e.sub, e.when] | select | join(" · ") }}</p>
{% if e.bullets %}<ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
</li>
{% endfor %}
</ol>
{% elif s == "skills" %}
{% for label, names in blocks["skills"].skills %}
<div class="skillgroup">
{% if label %}<h3>{{ label }}</h3>{% endif %}
<ul class="chips">{% for n in names.split(", ") %}<li>{{ n }}</li>{% endfor %}</ul>
</div>
{% endfor %}
{% elif s == "education" or s == "certifications" %}
<ul class="grid">
{% for e in blocks[s].entries %}
<li class="card">
<h3>{{ e.head }}</h3>
<p class="meta">{{ [e.sub, e.when] | select | join(" · ") }}</p>
{% if e.bullets %}<ul class="points">{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
</li>
{% endfor %}
</ul>
{% elif s == "languages" %}
<p>{{ blocks["languages"].paragraph }}</p>
{% endif %}
</section>
{% endfor %}
{% if contact %}
<section id="contact" aria-labelledby="h-contact">
<h2 id="h-contact">Contact</h2>
<ul class="contact">
{% for c in contact %}<li>{% if c.href %}<a href="{{ c.href }}">{{ c.text }}</a>{% else %}{{ c.text }}{% endif %}</li>
{% endfor %}
</ul>
</section>
{% endif %}
</main>
<footer>
<div class="wrap"><p>{{ p.name }} &middot; Last updated {{ today }}</p></div>
</footer>
</body>
</html>
