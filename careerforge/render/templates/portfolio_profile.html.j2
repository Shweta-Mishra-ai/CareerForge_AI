{% extends "portfolio_base.html.j2" %}
{% import "_pf.html.j2" as pf with context %}
{% block layout_css %}
.shell { width: min(100% - 2rem, 78rem); margin: 0 auto; display: grid; grid-template-columns: 18rem minmax(0, 1fr); gap: 2.75rem; padding: 2.5rem 0 1rem; align-items: start; }
header.profile { background: var(--surface); border: 1px solid var(--border); border-radius: 1.4rem; box-shadow: var(--shadow); overflow: hidden; }
header.profile .banner { height: 6.5rem; background: radial-gradient(circle at 15% 10%, var(--wash) 0, transparent 65%), radial-gradient(circle at 95% 90%, var(--wash2) 0, transparent 60%), var(--tint); border-bottom: 1px solid var(--border); }
header.profile .inner { padding: 0 1.75rem 1.75rem; }
header.profile .avatar { margin-top: -2.9rem; width: 5.8rem; height: 5.8rem; }
header.profile h1 { font-size: 1.85rem; margin-top: 1.1rem; letter-spacing: -0.025em; line-height: 1.15; }
header.profile .headline { color: var(--muted); margin-top: 0.35rem; font-size: 1.05rem; }
header.profile .where { color: var(--muted); font-size: 0.95rem; margin-top: 0.5rem; }
header.profile .stats { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--border); gap: 0.9rem 1.6rem; }
header.profile .stats strong { font-size: 1.55rem; }
header.profile .actions { margin-top: 1.4rem; flex-direction: column; }
header.profile nav { margin-top: 1.5rem; padding-top: 1.1rem; border-top: 1px solid var(--border); }
header.profile nav ul { flex-direction: column; gap: 0.05rem; }
header.profile nav a { display: block; padding: 0.4rem 0.7rem; margin-inline: -0.7rem; border-radius: 0.5rem; }
header.profile nav a:hover { background: var(--tint); text-decoration: none; }
.shell > main > .sec:first-child { margin-top: 0; }
.shell-foot { width: min(100% - 2rem, 78rem); margin: 0 auto; }
main { min-width: 0; }
@media (min-width: 46.01rem) and (min-height: 50rem) { header.profile { position: sticky; top: 1.5rem; } }
@media (max-width: 46rem) { .shell { grid-template-columns: 1fr; gap: 1.75rem; padding-top: 1.25rem; } header.profile nav ul { flex-direction: row; flex-wrap: wrap; gap: 0.2rem 0.4rem; } header.profile nav a { margin-inline: 0; } header.profile .actions { flex-direction: row; } .sec { margin-top: 2.5rem; } }
header.profile .status { margin-top: 1rem; }
{% endblock %}
{% block page %}
<div class="shell">
<header class="profile">
<div class="banner" aria-hidden="true"></div>
<div class="inner">
{{ pf.avatar() }}
{{ pf.status_pill() }}
<h1>{{ p.name }}</h1>
{% if p.headline %}<p class="headline">{{ p.headline }}</p>{% endif %}
{{ pf.where_line() }}
<div class="actions">{{ pf.buttons() }}</div>
{{ pf.stat_list() }}
{{ pf.nav() }}
</div>
</header>
<main id="main">
{{ pf.body() }}
{{ pf.contact_section() }}
</main>
</div>
<footer class="foot"><div class="shell-foot"><p>{{ p.name }} &middot; Last updated {{ today }}</p></div></footer>
{% endblock %}
