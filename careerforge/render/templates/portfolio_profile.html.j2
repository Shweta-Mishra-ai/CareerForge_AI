{% extends "portfolio_base.html.j2" %}
{% import "_pf.html.j2" as pf with context %}
{% block layout_css %}
.shell { width: min(100% - 2rem, 76rem); margin: 0 auto; display: grid; grid-template-columns: 17.5rem minmax(0, 1fr); gap: 2.5rem; padding: 2.5rem 0 1rem; align-items: start; }
header.profile { position: sticky; top: 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: 1.25rem; padding: 2rem 1.75rem; box-shadow: var(--shadow); }
header.profile h1 { font-size: 1.85rem; margin-top: 1.2rem; letter-spacing: -0.02em; }
header.profile .headline { color: var(--muted); margin-top: 0.3rem; font-size: 1.05rem; }
header.profile .where { color: var(--muted); font-size: 0.95rem; margin-top: 0.15rem; }
header.profile .stats { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--border); gap: 0.9rem 1.6rem; }
header.profile .stats strong { font-size: 1.5rem; }
header.profile .actions { margin-top: 1.4rem; }
header.profile .actions .button { flex: 1 1 auto; text-align: center; }
header.profile nav { margin-top: 1.5rem; padding-top: 1.2rem; border-top: 1px solid var(--border); }
header.profile nav ul { flex-direction: column; gap: 0.1rem; }
header.profile nav a { padding: 0.35rem 0; }
.shell > main > .sec:first-child { margin-top: 0; }
.shell-foot { width: min(100% - 2rem, 76rem); margin: 0 auto; }
main { min-width: 0; }
@media (max-width: 46rem) { .shell { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 1.25rem; } header.profile { position: static; } header.profile nav ul { flex-direction: row; flex-wrap: wrap; gap: 0.2rem 1.1rem; } .sec { margin-top: 2.25rem; } }
{% endblock %}
{% block page %}
<div class="shell">
<header class="profile">
<div class="avatar" aria-hidden="true">{{ initials }}</div>
<h1>{{ p.name }}</h1>
{% if p.headline %}<p class="headline">{{ p.headline }}</p>{% endif %}
{% if where %}<p class="where">{{ where }}</p>{% endif %}
<div class="actions">{{ pf.buttons() }}</div>
{{ pf.stat_list() }}
{{ pf.nav() }}
</header>
<main id="main">
{{ pf.body() }}
{{ pf.contact_section() }}
</main>
</div>
<footer class="foot"><div class="shell-foot"><p>{{ p.name }} &middot; Last updated {{ today }}</p></div></footer>
{% endblock %}
