{# Shared building blocks for every portfolio layout. Imported "with context", so it sees p, blocks, titles... #}

{% macro icon(name) -%}
<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if name == "email" %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
{%- elif name == "linkedin" %}<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>
{%- elif name == "github" %}<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>
{%- elif name == "website" %}<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
{%- elif name == "phone" %}<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>
{%- elif name == "download" %}<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/>
{%- elif name == "external" %}<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
{%- elif name == "code" %}<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>
{%- elif name == "pin" %}<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>
{%- elif name == "star" %}<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/>
{%- endif %}</svg>
{%- endmacro %}

{% macro buttons(primary_first=true) -%}
{% if cv_link %}<a class="button" href="{{ cv_link }}" download>{{ icon("download") }}Download my CV (PDF)</a>{% endif %}
{% if mail %}<a class="button{{ ' ghost' if cv_link else '' }}" href="{{ mail.href }}">{{ icon("email") }}Email me</a>{% endif %}
{%- endmacro %}

{% macro where_line() -%}
{% if where %}<p class="where">{{ icon("pin") }} {{ where }}</p>{% endif %}
{%- endmacro %}

{% macro nav(label="Sections") -%}
{% if sections or contact %}
<nav aria-label="{{ label }}">
<ul>
{% for s in sections %}<li><a href="#{{ s }}">{{ titles[s] }}</a></li>
{% endfor %}
{% if contact %}<li><a href="#contact">Contact</a></li>{% endif %}
</ul>
</nav>
{% endif %}
{%- endmacro %}

{% macro stat_list() -%}
{% if stats %}
<ul class="stats" aria-label="Summary figures">
{% for s in stats %}<li><strong>{{ s.value }}</strong><span>{{ s.label }}</span></li>
{% endfor %}
</ul>
{% endif %}
{%- endmacro %}

{% macro contact_list() -%}
{% set labels = {"email": "Email", "linkedin": "LinkedIn", "github": "GitHub", "website": "Website", "phone": "Phone"} %}
<ul class="contact">
{% for c in contact %}<li>{% if c.href %}<a class="tile" href="{{ c.href }}">{{ icon(c.kind) }}<span><small>{{ labels.get(c.kind, c.kind | capitalize) }}</small>{{ c.text }}</span></a>{% else %}<p class="tile">{{ icon(c.kind) }}<span>{{ c.text }}</span></p>{% endif %}</li>
{% endfor %}
</ul>
{%- endmacro %}

{% macro project_links(pr) -%}
{% if pr.url or pr.demo_url %}<p class="links">{% if pr.url %}<a href="{{ pr.url }}">{{ icon("code") }}Source</a>{% endif %}{% if pr.demo_url %}<a href="{{ pr.demo_url }}">{{ icon("external") }}Live demo</a>{% endif %}</p>{% endif %}
{%- endmacro %}

{% macro section(s) -%}
<section id="{{ s }}" class="sec sec-{{ s }}" aria-labelledby="h-{{ s }}">
<h2 id="h-{{ s }}">{{ titles[s] }}</h2>
{% if s == "about" %}
<p class="lead">{{ p.summary }}</p>
{% elif s == "projects" %}
{% if featured %}
{% if others %}<h3 class="sub">Featured</h3>{% endif %}
<ul class="featured">
{% for pr in featured %}
<li><article class="case">
<div class="cover">{{ cover(pr.name) }}</div>
<div class="body">
<p class="badge">Case study</p>
<h3>{{ pr.name }}</h3>
{% if pr.stars %}<p class="meta">{{ icon("star") }} {{ pr.stars }} {{ "star" if pr.stars == 1 else "stars" }} on GitHub</p>{% endif %}
{% if pr.description %}<p>{{ pr.description }}</p>{% endif %}
{% if pr.bullets %}<ul class="points">{% for b in pr.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
{% if pr.tech %}<ul class="chips" aria-label="Technologies">{% for t in pr.tech %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
{{ project_links(pr) }}
</div>
</article></li>
{% endfor %}
</ul>
{% endif %}
{% if others %}
{% if featured %}<h3 class="sub">More projects</h3>{% endif %}
<ul class="grid">
{% for pr in others %}
<li><article class="card proj">
<div class="cover">{{ cover(pr.name) }}</div>
<div class="body">
<h3>{% if pr.url %}<a href="{{ pr.url }}">{{ pr.name }}</a>{% else %}{{ pr.name }}{% endif %}</h3>
{% if pr.stars %}<p class="meta">{{ icon("star") }} {{ pr.stars }} {{ "star" if pr.stars == 1 else "stars" }} on GitHub</p>{% endif %}
{% if pr.description %}<p>{{ pr.description }}</p>{% endif %}
{% if pr.bullets %}<ul class="points">{% for b in pr.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
{% if pr.tech %}<ul class="chips" aria-label="Technologies">{% for t in pr.tech %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
{% if pr.demo_url %}<p class="links"><a href="{{ pr.demo_url }}">{{ icon("external") }}Live demo</a></p>{% endif %}
</div>
</article></li>
{% endfor %}
</ul>
{% endif %}
{% elif s == "experience" %}
<ol class="timeline">
{% for e in blocks["experience"].entries %}
<li class="job">
<span class="mono" aria-hidden="true">{{ monos[loop.index0] }}</span>
<div class="job-head"><h3>{{ e.head }}</h3>{% if e.when %}<span class="when">{{ e.when }}</span>{% endif %}</div>
{% if e.sub %}<p class="meta">{{ e.sub }}</p>{% endif %}
{% if e.bullets %}<ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
</li>
{% endfor %}
</ol>
{% elif s == "skills" %}
<div class="skills">
{% for label, names in blocks["skills"].skills %}
<div class="skillgroup">
{% if label %}<h3>{{ label }}</h3>{% endif %}
<ul class="chips">{% for n in names.split(", ") %}<li>{{ n }}</li>{% endfor %}</ul>
</div>
{% endfor %}
</div>
{% elif s == "education" or s == "certifications" %}
<ul class="grid">
{% for e in blocks[s].entries %}
<li class="card">
<h3>{{ e.head }}</h3>
<p class="meta">{{ [e.sub, e.when] | select | join(" · ") }}</p>
{% if e.bullets %}<ul class="points">{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
</li>
{% endfor %}
</ul>
{% elif s == "languages" %}
<p>{{ blocks["languages"].paragraph }}</p>
{% endif %}
</section>
{%- endmacro %}

{% macro body() -%}
{% for row in rows %}
{% if row | length > 1 %}<div class="pair">{% for s in row %}{{ section(s) }}{% endfor %}</div>
{% else %}{{ section(row[0]) }}{% endif %}
{% endfor %}
{%- endmacro %}

{% macro contact_section() -%}
{% if contact %}
<section id="contact" class="sec sec-contact band" aria-labelledby="h-contact">
<h2 id="h-contact">Contact</h2>
{{ contact_list() }}
</section>
{% endif %}
{%- endmacro %}
