{% extends "portfolio_base.html.j2" %}
{% import "_pf.html.j2" as pf with context %}
{% block layout_css %}
.wrap { width: min(100% - 2rem, 74rem); margin-inline: auto; }
.topbar { position: sticky; top: 0; z-index: 10; background: var(--bg); border-bottom: 1px solid var(--border); }
.topbar .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; padding: 0.8rem 0; }
.brand { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap; }
.brand i { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: 0.72rem; font-style: normal; }
.topbar nav ul { gap: 0.1rem 0.2rem; }
.topbar nav a { padding: 0.35rem 0.7rem; border-radius: 999px; font-size: 0.95rem; }
.topbar nav a:hover { background: var(--tint); text-decoration: none; }
.topbar .cta { padding: 0.5rem 1.1rem; border-radius: 999px; font-size: 0.92rem; white-space: nowrap; }
.spot { position: relative; isolation: isolate; overflow: hidden; padding: 5.5rem 0 4.5rem; border-bottom: 1px solid var(--border); background: radial-gradient(42rem 30rem at 78% 40%, var(--wash) 0, transparent 70%), radial-gradient(36rem 24rem at 0% 0%, var(--wash2) 0, transparent 70%), var(--bg); }
.spot::before { content: ""; position: absolute; inset: 0; z-index: -1; background-image: radial-gradient(var(--border) 1px, transparent 1.4px); background-size: 1.6rem 1.6rem; opacity: 0.55; -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 0, transparent 70%); mask-image: radial-gradient(ellipse at 70% 40%, #000 0, transparent 70%); }
.spot .grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 3rem; align-items: center; }
.spot .copy > * + * { margin-top: 1rem; }
.pills { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
.pills .status, .chipline { margin: 0; }
.chipline { display: inline-flex; align-items: center; gap: 0.45rem; width: fit-content; max-width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 0.25rem 0.9rem 0.25rem 0.65rem; font-size: 0.85rem; color: var(--muted); }
.chipline .ico { color: var(--accent); }
.kicker { color: var(--accent); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.9rem; margin-top: 1.4rem !important; }
.spot h1 { font-size: clamp(2.6rem, 6.4vw, 4.6rem); line-height: 1.02; letter-spacing: -0.035em; font-weight: 800; text-transform: uppercase; overflow-wrap: anywhere; margin-top: 0.4rem !important; }
.spot .lead { color: var(--muted); font-size: 1.12rem; max-width: 36rem; }
.spot .actions { margin-top: 1.8rem !important; }
.spot .actions .button { border-radius: 999px; padding: 0.75rem 1.4rem; }
.visual { position: relative; display: grid; place-items: center; min-height: 24rem; }
.orb { position: relative; width: min(21rem, 78vw); aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; }
.orb::before, .orb::after { content: ""; position: absolute; border-radius: 50%; border: 1px solid var(--border); }
.orb::before { inset: -7%; }
.orb::after { inset: -18%; opacity: 0.55; border-style: dashed; }
.orb .avatar { width: 100%; height: auto; aspect-ratio: 1; font-size: clamp(3rem, 9vw, 5rem); box-shadow: 0 0 0 0.45rem var(--surface), 0 0 0 0.5rem var(--border), 0 0 5rem var(--wash2), var(--shadow); }
.orb div.avatar { background: radial-gradient(circle at 35% 25%, var(--surface), var(--bg)); color: var(--accent); }
.float { position: absolute; display: flex; align-items: center; gap: 0.55rem; max-width: 15rem; background: var(--surface); border: 1px solid var(--border); border-radius: 0.9rem; padding: 0.65rem 0.95rem; box-shadow: var(--shadow); font-size: 0.88rem; font-weight: 600; line-height: 1.3; }
.float .ico { color: var(--accent); }
.float .dot { flex: none; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0.25rem var(--tint); }
.float.f1 { top: 6%; left: -2%; }
.float.f2 { bottom: 6%; left: 2%; }
.spot .stats { margin-top: 2.2rem !important; gap: 0.8rem; }
.spot .stats li { background: var(--surface); border: 1px solid var(--border); border-radius: 1rem; padding: 0.8rem 1.3rem; }
@media (max-width: 62rem) { .topbar nav { display: none; } }
@media (max-width: 52rem) { .spot { padding: 3rem 0 2.75rem; } .spot .grid { grid-template-columns: 1fr; gap: 2rem; } .visual { min-height: 0; order: -1; display: flex; flex-flow: row wrap; align-items: center; gap: 0.6rem 1.1rem; } .orb { width: 6.5rem; flex: none; } .orb::before { inset: -6%; } .orb::after { display: none; } .orb .avatar { font-size: 2.2rem; } .float { position: static; max-width: none; } }
@media (max-width: 30rem) { .topbar .cta { display: none; } }
{% endblock %}
{% block page %}
<header class="topbar"><div class="wrap">
<span class="brand"><i aria-hidden="true">{{ initials }}</i>{{ p.name }}</span>
{{ pf.nav() }}
{% if mail %}<a class="button cta" href="{{ mail.href }}">Email me</a>{% endif %}
</div></header>
<section class="spot" aria-label="Introduction">
<div class="wrap grid">
<div class="copy">
{% if top_skills or options.open_to_work %}<div class="pills">
{% if top_skills %}<p class="chipline">{{ pf.icon("sparkle") }}{{ top_skills | join(" · ") }}</p>{% endif %}
{{ pf.status_pill() }}
</div>{% endif %}
{% if p.headline %}
<p class="kicker">{{ p.name }}</p>
<h1>{{ pf.gradient_headline(p.headline) }}</h1>
{% else %}
<h1>{{ pf.gradient_headline(p.name) }}</h1>
{% endif %}
{{ pf.hero_about() }}
<div class="actions">{{ pf.buttons() }}{% if "projects" in sections and p.projects %}<a class="button ghost" href="#projects">Projects {{ pf.icon("arrow") }}</a>{% endif %}</div>
{{ pf.stat_list() }}
</div>
<div class="visual">
<div class="orb">{{ pf.avatar() }}</div>
{% if where %}<p class="float f1">{{ pf.icon("pin") }}{{ where }}</p>{% endif %}
{% if current %}<p class="float f2"><span class="dot" aria-hidden="true"></span>{{ [current.title, current.company] | select | join(" · ") }}</p>{% endif %}
</div>
</div>
</section>
<main id="main" class="wrap">
{{ pf.body() }}
{{ pf.contact_section() }}
</main>
<footer><div class="wrap"><p>{{ p.name }} &middot; Last updated {{ today }}</p></div></footer>
{% endblock %}
