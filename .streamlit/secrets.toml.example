# Copy to .streamlit/secrets.toml (git-ignored) and fill in real values.
# On Streamlit Community Cloud, paste the same lines into the app's Settings > Secrets instead.
# Every line is optional: with none of them the app runs in basic (no-AI) mode.
# Keep every line at the TOP LEVEL (no [section] header above it) and keep the quotes: a key under a header, or a
# line without quotes, is ignored, and Settings in the app will say so.

GEMINI_API_KEY = "your_gemini_api_key_here"
GROQ_API_KEY = "your_groq_api_key_here"

# Pin models (comma separated) instead of discovering them. Run `python -m careerforge.ai.doctor` to see what works.
# CAREERFORGE_GEMINI_MODELS = "model-a,model-b"
# CAREERFORGE_GROQ_MODELS = "model-c"

# AI actions each visitor session may use of YOUR key (default 30). Visitors who add their own key are not limited.
# CAREERFORGE_SESSION_AI_LIMIT = "30"

# Raises GitHub's rate limit for the GitHub import.
# GITHUB_TOKEN = "ghp_..."

# Enables the Adzuna job board (free keys from developer.adzuna.com).
# ADZUNA_APP_ID = ""
# ADZUNA_APP_KEY = ""
